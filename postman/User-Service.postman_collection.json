{
	"info": {
		"_postman_id": "user-service-collection-001",
		"name": "User Service",
		"description": "API collection for the User Service (FastAPI).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8000"
		}
	],
	"item": [
		{
			"name": "Users",
			"item": [
				{
					"name": "List users",
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/v1/users"
					}
				},
				{
					"name": "Get user by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/v1/users/1"
					}
				},
				{
					"name": "Create user",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"age\": 30\n}"
						},
						"url": "{{baseUrl}}/v1/users"
					}
				},
				{
					"name": "Update user",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Jane Smith\",\n  \"email\": \"jane.smith@example.com\",\n  \"age\": 31\n}"
						},
						"url": "{{baseUrl}}/v1/users/1"
					}
				}
			]
		}
	]
}
